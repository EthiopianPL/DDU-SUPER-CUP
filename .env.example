# Database Connection (Supabase PostgreSQL pooler or direct connection)
# Serverless platforms (Vercel, AWS Lambda) should use the port 6543 pooler:
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres

# Administrator Password
ADMIN_PASSWORD=supercup

# Media Storage Provider
# 'local' uses the PostgreSQL database `media` table (recommended, works everywhere with zero extra config)
# 'supabase' uses Supabase Storage S3 bucket (requires SUPABASE_ANON_KEY or SUPABASE_SERVICE_ROLE_KEY)
IMAGE_STORAGE_PROVIDER=local

# Supabase Project Configuration
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=ddu-super-cup-media

# Optional Supabase API Keys (Required only if IMAGE_STORAGE_PROVIDER=supabase)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Static Asset CDN (Team crests, badges, and tournament branding)
VITE_STATIC_ASSETS_BASE_URL=https://cdn.jsdelivr.net/gh/EthiopianPL/ddu-super-cup-assets@main
