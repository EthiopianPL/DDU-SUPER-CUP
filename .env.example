# Database Connection (Supabase PostgreSQL pooler or direct connection)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Super Administrator Password
ADMIN_PASSWORD=supercup

# Hybrid Media Architecture & Storage Provider
# Allowed: 'supabase' (mandatory in production) or 'local' (development/test only)
IMAGE_STORAGE_PROVIDER=supabase

# Supabase Storage Configuration (Required for production photo uploads & dynamic media)
SUPABASE_URL=https://jojzuicgyfhpbqdjtpby.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=ddu-super-cup-media

# Public Static Asset Repository (GitHub)
# Base URL for static crests, branding, and group badges
VITE_STATIC_ASSETS_BASE_URL=https://cdn.jsdelivr.net/gh/EthiopianPL/ddu-super-cup-assets@main
